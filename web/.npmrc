engine-strict=true
# Vendor-Kopie (Etappe 3a-3): Pakete aus web/vendor/<paket> als Kopie
# einbauen, nicht als Verknüpfung. Eine Verknüpfung zählt für npm als eigenes
# Projekt und holte dessen devDependencies aus dem Netz.
install-links=true
# Keine Paket-Skripte bei npm ci und npm install (sonst liefe beim Kopieren
# der Vendor-Ordner deren prepare, etwa husky). Unsere eigenen Vorstufen
# stehen darum direkt in den Skripten (build, check, lint, test).
ignore-scripts=true
